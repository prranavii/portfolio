+        setAttrOnce(P.eyes, 'display', happy ? 'none' : 'inline');
+        setAttrOnce(P.mouthO, 'display', happy ? 'inline' : 'none');
+        setAttrOnce(P.mouthN, 'display', happy ? 'none' : 'inline');
+      }
