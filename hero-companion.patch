+    };
+
+    // ---------- drawing ----------
+    const draw = (now) => {
+      const s = S.s;
+      const sinP = Math.abs(Math.sin(S.runPhase));
+      const rb = S.runBlend;
+      const runHop = sinP * (2.5 + 9 * S.energy) * rb;
+      const lift = S.air + runHop;
+
+      const breathe = Math.sin(now * 3.2) * 0.014 * (1 - rb);
