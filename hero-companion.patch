+      S.tx = clamp(S.tx, S.minX, S.maxX);
+      S.ty = clamp(S.ty, S.minY, S.maxY);
+
+      // spring (semi-implicit Euler, 2 sub-steps)
+      let k = 40, zeta = 0.9;
+      if (S.mode === 'follow') { k = 52; zeta = 0.55; }
