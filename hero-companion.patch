+      // place creature + shadow (positions live in CSS transforms, not layout)
+      P.creature.style.transform = `translate3d(${(S.x - CW / 2).toFixed(2)}px, ${(S.y - FEET - lift).toFixed(2)}px, 0) scale(${s.toFixed(3)})`;
